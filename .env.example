FRP_USERNAME=your_account_or_email_or_phone
FRP_PASSWORD=your_password
PUSHPLUS_TOKEN=optional_pushplus_token
# PushPlus channel, for example: wechat or webhook
PUSHPLUS_CHANNEL=optional_channel
TG_BOT_TOKEN=optional_telegram_bot_token
TG_CHAT_ID=optional_telegram_chat_id
# 签到方式顺序（checkin-v2.js 使用）：auto=方法A(纯API)优先、失败回退方法B(浏览器)
# 也可填 api / browser / browser,api
CHECKIN_STRATEGY=auto
# 方法A 单个请求超时（毫秒），默认 15000
FRP_API_TIMEOUT_MS=15000